# 데모 배포용 환경 변수 예시. 서버에서 `.env.prod`로 복사해 값을 채운다.
#
#   scp .env.prod  <서버>:/opt/puppytalk/.env.prod
#   docker compose --env-file .env.prod -f compose.prod.yml up -d
#
# 이 파일(예시)만 커밋하고 실제 값이 든 .env.prod 는 절대 커밋하지 않는다.
# 시크릿을 terraform·user_data에 넣지 않는 이유: tfstate와 인스턴스 메타데이터에 평문으로 남는다.
#
# ENVIRONMENT=production 이면 app/core/config.py 의 validate_settings_for_environment()가
# 기동 전에 아래 값들을 검사하고, 하나라도 안전하지 않으면 프로세스를 띄우지 않는다.
# 검증에 걸리는 항목은 각 줄에 [가드]로 표시했다.

# ----- 서버 -----
ENVIRONMENT=production
DEBUG=false
# [가드] localhost/127.0.0.1이 있으면 기동 실패. 프론트 오리진만.
CORS_ORIGINS=https://puppytalk.shop
# [가드] "*" 금지. API가 응답할 Host.
TRUSTED_HOSTS=api.puppytalk.shop

# ----- 프록시 (Caddy 뒤) -----
# [가드] 둘 다 필수. 없으면 모든 요청의 클라이언트 IP가 Caddy 컨테이너 IP 하나로 수렴해
# rate limit이 사이트 전체를 429로 조이고 조회수 dedup도 무너진다.
TRUST_X_FORWARDED_FOR=true
# compose.prod.yml 의 네트워크 서브넷과 반드시 같은 값.
TRUSTED_PROXY_IPS=172.30.0.0/24

# ----- DB (compose의 db 서비스. DB_USER/PASSWORD/NAME은 postgres 초기화에도 쓰인다) -----
DB_HOST=db
DB_PORT=5432
DB_USER=puppytalk
# [가드] 비어 있으면 기동 실패. 긴 무작위 문자열로.
DB_PASSWORD=
DB_NAME=puppytalk
# 2GB 인스턴스 + gunicorn 워커 2개 기준. 로컬 기본값(20)은 이 크기에 과하다.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# WRITER/READER를 비워두면 위 DB_* 로 단일 URL을 구성한다(데모는 읽기 복제본 없음).
WRITER_DB_URL=
READER_DB_URL=

# ----- 인증 -----
# [가드] 32자 이상, 기본값 금지.  생성: openssl rand -hex 32
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_SECONDS=1800
REFRESH_TOKEN_EXPIRE_DAYS=7
# [가드] HTTPS 배포이므로 true.
COOKIE_SECURE=true
# bcrypt 입력에 덧붙는 pepper. 한 번 정하면 바꾸지 않는다(기존 해시 검증에 폴백이 있지만
# 새 비밀번호는 이 값으로 굳는다).  생성: openssl rand -hex 16
PASSWORD_PEPPER=

# ----- Redis · Celery -----
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=64
# true면 알림 발행이 Celery 워커로 간다. false면 인라인 폴백으로 조용히 동작해서
# "워커가 죽었는데 아무도 모르는" 상태가 되므로 데모에서도 켜 둔다.
CELERY_ENABLED=true

# ----- 스토리지 (실제 S3. MinIO를 쓰지 않으므로 S3_ENDPOINT_URL은 비운다) -----
# [가드] S3_BUCKET_NAME · AWS_ACCESS_KEY_ID · AWS_SECRET_ACCESS_KEY 셋 다 필요.
# 키는 terraform demo/ 가 만드는 앱 전용 IAM 유저의 것(미디어 버킷 권한만 가진다).
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_ENDPOINT_URL=
# 비워두면 https://<버킷>.s3.<리전>.amazonaws.com/media/<key> 로 자동 구성된다.
# CloudFront로 미디어를 서빙하게 되면 그때 이 값을 채운다.
S3_PUBLIC_BASE_URL=

# ----- 보안 헤더 -----
HSTS_ENABLED=true

# ----- 업로드 -----
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ----- 로깅 -----
LOG_LEVEL=INFO
SLOW_REQUEST_MS=1000

# ----- Caddy (compose가 읽어 Caddyfile에 주입) -----
API_DOMAIN=api.puppytalk.shop

# ----- 배포 이미지 (특정 커밋으로 고정하려면 :latest 대신 :<sha>) -----
BACKEND_IMAGE=ghcr.io/kyjness/puppytalk:latest
